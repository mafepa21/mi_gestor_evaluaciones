-- Migration from version 16 to 17
-- Scope grade uniqueness by class and keep one canonical legacy row per class/student/column.

PRAGMA foreign_keys = 0;

DROP TABLE IF EXISTS grades_migration_v16;

CREATE TABLE grades_migration_v16 (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    column_id TEXT NOT NULL,
    evaluation_id INTEGER,
    value REAL,
    evidence TEXT,
    evidence_path TEXT,
    rubric_selections TEXT,
    created_at_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(class_id, student_id, column_id),
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (evaluation_id) REFERENCES evaluations(id) ON DELETE SET NULL
);

INSERT INTO grades_migration_v16 (
    id,
    class_id,
    student_id,
    column_id,
    evaluation_id,
    value,
    evidence,
    evidence_path,
    rubric_selections,
    created_at_epoch_ms,
    updated_at_epoch_ms,
    device_id,
    sync_version
)
SELECT
    g.id,
    g.class_id,
    g.student_id,
    g.column_id,
    g.evaluation_id,
    g.value,
    g.evidence,
    g.evidence_path,
    g.rubric_selections,
    g.created_at_epoch_ms,
    g.updated_at_epoch_ms,
    g.device_id,
    g.sync_version
FROM grades AS g
WHERE g.class_id IS NOT NULL
  AND g.student_id IS NOT NULL
  AND g.column_id IS NOT NULL
  AND NOT EXISTS (
      SELECT 1
      FROM grades AS newer
      WHERE newer.class_id = g.class_id
        AND newer.student_id = g.student_id
        AND newer.column_id = g.column_id
        AND (
            newer.updated_at_epoch_ms > g.updated_at_epoch_ms
            OR (
                newer.updated_at_epoch_ms = g.updated_at_epoch_ms
                AND newer.created_at_epoch_ms > g.created_at_epoch_ms
            )
            OR (
                newer.updated_at_epoch_ms = g.updated_at_epoch_ms
                AND newer.created_at_epoch_ms = g.created_at_epoch_ms
                AND newer.id > g.id
            )
        )
);

DROP TABLE grades;

ALTER TABLE grades_migration_v16 RENAME TO grades;

CREATE INDEX IF NOT EXISTS idx_grades_class_student
ON grades(class_id, student_id);

CREATE INDEX IF NOT EXISTS idx_grades_class_column
ON grades(class_id, column_id);

CREATE INDEX IF NOT EXISTS idx_grades_evaluation
ON grades(evaluation_id);

PRAGMA foreign_keys = 1;
