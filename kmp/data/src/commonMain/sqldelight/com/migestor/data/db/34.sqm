-- Medidas de respuesta educativa Nivel III/IV (Decreto 104/2018 + Orden 20/2019, CV).
-- Puramente aditiva, no toca ninguna tabla existente. Ver AppDatabase.sq para el
-- razonamiento de por qué cuelga del alumno global y no del curso escolar.
CREATE TABLE IF NOT EXISTS student_support_measures (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id INTEGER NOT NULL,
    level TEXT NOT NULL,
    measure_type TEXT NOT NULL,
    start_date_iso TEXT NOT NULL,
    end_date_iso TEXT,
    responsible TEXT,
    intensity TEXT,
    follow_up_notes TEXT NOT NULL DEFAULT '',
    document_ref TEXT,
    review_due_iso TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_support_measures_student ON student_support_measures(student_id, is_active);
