-- Migración 44: el estado por defecto de la sesión pasa a PLANNED.
-- Las filas PENDING, vacías o nulas pasan a PLANNED. El resto se conserva.
-- La copia de planned_session vive en RescueMigrations: así no rompe
-- bases de prueba que tienen esa tabla a medias.

PRAGMA foreign_keys = 0;

DROP TABLE IF EXISTS planner_session_v44;

CREATE TABLE planner_session_v44 (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT NOT NULL,
    group_id INTEGER NOT NULL,
    period INTEGER NOT NULL,
    unit_id INTEGER,
    objectives TEXT DEFAULT '',
    activities TEXT DEFAULT '',
    evaluation TEXT DEFAULT '',
    linked_assessment_ids_csv TEXT NOT NULL DEFAULT '',
    teacher_schedule_slot_id INTEGER,
    start_time TEXT,
    end_time TEXT,
    learning_situation_session_plan_id INTEGER,
    status TEXT DEFAULT 'PLANNED',
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(date, group_id, period),
    FOREIGN KEY (group_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (unit_id) REFERENCES teaching_unit(id) ON DELETE SET NULL,
    FOREIGN KEY (teacher_schedule_slot_id) REFERENCES teacher_schedule_slots(id) ON DELETE SET NULL
);

INSERT INTO planner_session_v44 (
    id,
    date,
    group_id,
    period,
    unit_id,
    objectives,
    activities,
    evaluation,
    linked_assessment_ids_csv,
    teacher_schedule_slot_id,
    start_time,
    end_time,
    learning_situation_session_plan_id,
    status,
    updated_at_epoch_ms,
    device_id,
    sync_version
)
SELECT
    id,
    date,
    group_id,
    period,
    unit_id,
    objectives,
    activities,
    evaluation,
    linked_assessment_ids_csv,
    teacher_schedule_slot_id,
    start_time,
    end_time,
    learning_situation_session_plan_id,
    CASE
        WHEN status IS NULL OR TRIM(status) = '' OR status = 'PENDING' THEN 'PLANNED'
        ELSE status
    END,
    updated_at_epoch_ms,
    device_id,
    sync_version
FROM planner_session;

DROP TABLE planner_session;

ALTER TABLE planner_session_v44 RENAME TO planner_session;

CREATE INDEX IF NOT EXISTS idx_planner_session_group_date_period
ON planner_session(group_id, date, period);

CREATE INDEX IF NOT EXISTS idx_planner_session_unit
ON planner_session(unit_id);

CREATE INDEX IF NOT EXISTS idx_planner_session_slot_status_date
ON planner_session(teacher_schedule_slot_id, status, date);

PRAGMA foreign_keys = 1;
