-- Migración 45: tareas y plazos del Manual de Inclusión. Solo aditiva.

-- Plazos y tareas del Manual de Inclusión (curso escolar).
-- Cuelga del alumno global pero se separa por school_year ('2026-2027'): cada curso
-- genera su propia lista y la del curso anterior queda como histórico.
-- template_key NULL = tarea libre del docente. Con clave, la UNIQUE impide duplicar
-- una plantilla del manual al regenerar (en SQLite los NULL no chocan entre sí).
CREATE TABLE IF NOT EXISTS inclusion_tasks (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id INTEGER NOT NULL,
    measure_id INTEGER,
    template_key TEXT,
    title TEXT NOT NULL,
    phase TEXT NOT NULL,
    due_date_iso TEXT NOT NULL,
    due_is_custom INTEGER NOT NULL DEFAULT 0,
    done_at_iso TEXT,
    notes TEXT NOT NULL DEFAULT '',
    school_year TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    UNIQUE(student_id, template_key, school_year),
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (measure_id) REFERENCES student_support_measures(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_inclusion_tasks_student ON inclusion_tasks(student_id, school_year);
CREATE INDEX IF NOT EXISTS idx_inclusion_tasks_due ON inclusion_tasks(due_date_iso);

-- Fecha de evaluación inicial por grupo y curso: mueve las tareas que dependen de ella.
CREATE TABLE IF NOT EXISTS inclusion_group_settings (
    class_id INTEGER NOT NULL,
    school_year TEXT NOT NULL,
    initial_eval_date_iso TEXT NOT NULL,
    PRIMARY KEY (class_id, school_year),
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE
);
