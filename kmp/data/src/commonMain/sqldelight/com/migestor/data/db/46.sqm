-- Migración 46: torneos dentro de la Situación de Aprendizaje. Solo aditiva.

-- Torneo de una SdA (cuelga de la situación y del grupo; se borra con cualquiera de los dos).
-- El motor del torneo vive en Swift: aquí solo se guardan los JSON tal cual.
CREATE TABLE IF NOT EXISTS learning_situation_tournaments (
    id TEXT PRIMARY KEY NOT NULL,
    learning_situation_id INTEGER NOT NULL,
    class_id INTEGER NOT NULL,
    tab_id TEXT,
    name TEXT NOT NULL,
    format TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'draft',
    config_json TEXT NOT NULL DEFAULT '{}',
    team_snapshot_json TEXT NOT NULL DEFAULT '[]',
    schedule_json TEXT NOT NULL DEFAULT '[]',
    results_json TEXT NOT NULL DEFAULT '{}',
    knockout_results_json TEXT NOT NULL DEFAULT '{}',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (learning_situation_id) REFERENCES learning_situations(id) ON DELETE CASCADE,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_learning_situation_tournaments_situation ON learning_situation_tournaments(learning_situation_id, created_at_epoch_ms);
