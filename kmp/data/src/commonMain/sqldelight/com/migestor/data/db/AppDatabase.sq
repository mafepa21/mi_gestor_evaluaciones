CREATE TABLE IF NOT EXISTS notebook_tabs (
    id          TEXT NOT NULL PRIMARY KEY,
    class_id    INTEGER NOT NULL,
    title       TEXT NOT NULL,
    parent_tab_id TEXT,
    sort_order  INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id   TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    fixed_column_width REAL,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (parent_tab_id) REFERENCES notebook_tabs(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_tabs_class ON notebook_tabs(class_id);
CREATE INDEX IF NOT EXISTS idx_tabs_parent ON notebook_tabs(parent_tab_id, sort_order, id);

CREATE TABLE IF NOT EXISTS notebook_columns (
    id              TEXT NOT NULL PRIMARY KEY,
    class_id        INTEGER NOT NULL,
    title           TEXT NOT NULL,
    type            TEXT NOT NULL,         -- NotebookColumnType enum
    category_kind   TEXT NOT NULL DEFAULT 'CUSTOM',
    instrument_kind TEXT NOT NULL DEFAULT 'CUSTOM',
    input_kind      TEXT NOT NULL DEFAULT 'TEXT',
    evaluation_id   INTEGER,
    formula         TEXT,
    weight          REAL NOT NULL DEFAULT 1.0,
    date_epoch_ms   INTEGER,
    unit_name       TEXT,
    competency_criteria_ids_csv TEXT NOT NULL DEFAULT '',
    scale_kind      TEXT NOT NULL DEFAULT 'CUSTOM',
    tab_ids_csv     TEXT NOT NULL DEFAULT '',
    shared_across_tabs INTEGER NOT NULL DEFAULT 0,
    color_hex       TEXT NOT NULL DEFAULT '#FFFFFF',
    icon_name       TEXT,
    sort_order      INTEGER NOT NULL DEFAULT 0,
    width_dp        REAL NOT NULL DEFAULT 132.0,
    category_id     TEXT,
    visibility      TEXT NOT NULL DEFAULT 'VISIBLE',
    is_locked       INTEGER NOT NULL DEFAULT 0,
    counts_toward_average INTEGER NOT NULL DEFAULT 1,
    is_pinned       INTEGER NOT NULL DEFAULT 0,
    is_hidden       INTEGER NOT NULL DEFAULT 0,
    is_template     INTEGER NOT NULL DEFAULT 0,
    empty_cell_policy TEXT NOT NULL DEFAULT 'EXCLUDE_FROM_AVERAGE',
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id       TEXT,
    sync_version    INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (evaluation_id) REFERENCES evaluations(id) ON DELETE SET NULL,
    FOREIGN KEY (category_id) REFERENCES notebook_column_categories(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_columns_class ON notebook_columns(class_id);
CREATE INDEX IF NOT EXISTS idx_columns_class_category ON notebook_columns(class_id, category_id, sort_order, id);

CREATE TABLE IF NOT EXISTS notebook_column_categories (
    id                  TEXT NOT NULL PRIMARY KEY,
    class_id            INTEGER NOT NULL,
    tab_id              TEXT NOT NULL,
    name                TEXT NOT NULL,
    sort_order          INTEGER NOT NULL DEFAULT 0,
    is_collapsed        INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id           TEXT,
    sync_version        INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (tab_id) REFERENCES notebook_tabs(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_column_categories_class_tab ON notebook_column_categories(class_id, tab_id, sort_order, id);

CREATE TABLE IF NOT EXISTS notebook_work_groups (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id        INTEGER NOT NULL,
    tab_id          TEXT NOT NULL,
    name            TEXT NOT NULL,
    sort_order      INTEGER NOT NULL DEFAULT 0,
    learning_situation_id INTEGER REFERENCES learning_situations(id) ON DELETE SET NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id       TEXT,
    sync_version    INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (tab_id) REFERENCES notebook_tabs(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_work_groups_class_tab ON notebook_work_groups(class_id, tab_id, sort_order, id);

CREATE TABLE IF NOT EXISTS notebook_work_group_members (
    class_id        INTEGER NOT NULL,
    tab_id          TEXT NOT NULL,
    group_id        INTEGER NOT NULL,
    student_id      INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id       TEXT,
    sync_version    INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (class_id, tab_id, student_id),
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (tab_id) REFERENCES notebook_tabs(id) ON DELETE CASCADE,
    FOREIGN KEY (group_id) REFERENCES notebook_work_groups(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_work_group_members_class_tab ON notebook_work_group_members(class_id, tab_id, group_id, student_id);

CREATE TABLE IF NOT EXISTS ai_audit_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    created_at_epoch_ms INTEGER NOT NULL,
    service TEXT NOT NULL,
    use_case TEXT NOT NULL,
    report_kind TEXT,
    class_id INTEGER,
    student_hash TEXT,
    availability TEXT NOT NULL,
    model_available INTEGER NOT NULL DEFAULT 0,
    success INTEGER NOT NULL DEFAULT 0,
    duration_ms INTEGER NOT NULL DEFAULT 0,
    error_kind TEXT,
    error_message TEXT
);
CREATE INDEX IF NOT EXISTS idx_ai_audit_created ON ai_audit_events(created_at_epoch_ms DESC);
CREATE INDEX IF NOT EXISTS idx_ai_audit_use_case ON ai_audit_events(use_case, created_at_epoch_ms DESC);
CREATE INDEX IF NOT EXISTS idx_ai_audit_success ON ai_audit_events(success, created_at_epoch_ms DESC);

CREATE TABLE IF NOT EXISTS physical_test_definitions (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    capacity TEXT NOT NULL,
    measurement_kind TEXT NOT NULL,
    unit TEXT NOT NULL,
    higher_is_better INTEGER NOT NULL,
    protocol TEXT NOT NULL DEFAULT '',
    material TEXT NOT NULL DEFAULT '',
    attempts INTEGER NOT NULL DEFAULT 1,
    result_mode TEXT NOT NULL DEFAULT 'BEST',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS physical_test_batteries (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    default_course INTEGER,
    default_age_from INTEGER,
    default_age_to INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS physical_test_battery_items (
    battery_id TEXT NOT NULL,
    test_id TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (battery_id, test_id),
    FOREIGN KEY (battery_id) REFERENCES physical_test_batteries(id) ON DELETE CASCADE,
    FOREIGN KEY (test_id) REFERENCES physical_test_definitions(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_physical_battery_items_battery ON physical_test_battery_items(battery_id);
CREATE INDEX IF NOT EXISTS idx_physical_battery_items_test ON physical_test_battery_items(test_id);

CREATE TABLE IF NOT EXISTS physical_test_assignments (
    id TEXT NOT NULL PRIMARY KEY,
    battery_id TEXT NOT NULL,
    class_id INTEGER NOT NULL,
    course INTEGER,
    age_from INTEGER,
    age_to INTEGER,
    term_label TEXT,
    date_epoch_ms INTEGER NOT NULL,
    raw_column_mode INTEGER NOT NULL DEFAULT 1,
    score_column_mode INTEGER NOT NULL DEFAULT 1,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (battery_id) REFERENCES physical_test_batteries(id) ON DELETE CASCADE,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_physical_assignments_class ON physical_test_assignments(class_id);
CREATE INDEX IF NOT EXISTS idx_physical_assignments_battery ON physical_test_assignments(battery_id);
CREATE INDEX IF NOT EXISTS idx_physical_assignments_date ON physical_test_assignments(date_epoch_ms);

CREATE TABLE IF NOT EXISTS physical_test_scales (
    id TEXT NOT NULL PRIMARY KEY,
    test_id TEXT NOT NULL,
    name TEXT NOT NULL,
    course INTEGER,
    age_from INTEGER,
    age_to INTEGER,
    sex TEXT,
    battery_id TEXT,
    direction TEXT NOT NULL,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (test_id) REFERENCES physical_test_definitions(id) ON DELETE CASCADE,
    FOREIGN KEY (battery_id) REFERENCES physical_test_batteries(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_physical_scales_test ON physical_test_scales(test_id);
CREATE INDEX IF NOT EXISTS idx_physical_scales_battery ON physical_test_scales(battery_id);

CREATE TABLE IF NOT EXISTS physical_test_scale_ranges (
    id TEXT NOT NULL PRIMARY KEY,
    scale_id TEXT NOT NULL,
    min_value REAL,
    max_value REAL,
    score REAL NOT NULL,
    label TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (scale_id) REFERENCES physical_test_scales(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_physical_scale_ranges_scale ON physical_test_scale_ranges(scale_id);

CREATE TABLE IF NOT EXISTS physical_test_results (
    id TEXT NOT NULL PRIMARY KEY,
    assignment_id TEXT NOT NULL,
    test_id TEXT NOT NULL,
    class_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    raw_value REAL,
    raw_text TEXT NOT NULL DEFAULT '',
    score REAL,
    scale_id TEXT,
    observed_at_epoch_ms INTEGER NOT NULL,
    raw_column_id TEXT,
    score_column_id TEXT,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(assignment_id, test_id, student_id),
    FOREIGN KEY (assignment_id) REFERENCES physical_test_assignments(id) ON DELETE CASCADE,
    FOREIGN KEY (test_id) REFERENCES physical_test_definitions(id) ON DELETE CASCADE,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (scale_id) REFERENCES physical_test_scales(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_physical_results_assignment ON physical_test_results(assignment_id);
CREATE INDEX IF NOT EXISTS idx_physical_results_student ON physical_test_results(student_id);
CREATE INDEX IF NOT EXISTS idx_physical_results_test ON physical_test_results(test_id);
CREATE INDEX IF NOT EXISTS idx_physical_results_class ON physical_test_results(class_id);
CREATE INDEX IF NOT EXISTS idx_physical_results_scale ON physical_test_results(scale_id);
CREATE INDEX IF NOT EXISTS idx_physical_results_observed ON physical_test_results(observed_at_epoch_ms);

CREATE TABLE IF NOT EXISTS physical_test_attempts (
    id TEXT NOT NULL PRIMARY KEY,
    result_id TEXT NOT NULL,
    attempt_number INTEGER NOT NULL,
    raw_value REAL,
    raw_text TEXT NOT NULL DEFAULT '',
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(result_id, attempt_number),
    FOREIGN KEY (result_id) REFERENCES physical_test_results(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_physical_attempts_result ON physical_test_attempts(result_id);

CREATE TABLE IF NOT EXISTS physical_test_notebook_links (
    assignment_id TEXT NOT NULL,
    test_id TEXT NOT NULL,
    raw_column_id TEXT,
    score_column_id TEXT,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (assignment_id, test_id),
    FOREIGN KEY (assignment_id) REFERENCES physical_test_assignments(id) ON DELETE CASCADE,
    FOREIGN KEY (test_id) REFERENCES physical_test_definitions(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_physical_links_assignment ON physical_test_notebook_links(assignment_id);
CREATE INDEX IF NOT EXISTS idx_physical_links_test ON physical_test_notebook_links(test_id);

