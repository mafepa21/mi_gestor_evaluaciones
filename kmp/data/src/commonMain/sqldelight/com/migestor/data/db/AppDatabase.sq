selectPhysicalTestHistoryForStudent:
SELECT
  r.id AS result_id,
  r.test_id,
  d.name AS test_name,
  r.class_id,
  r.raw_value,
  r.raw_text,
  r.score,
  r.observed_at_epoch_ms
FROM physical_test_results r
JOIN physical_test_definitions d ON d.id = r.test_id
WHERE r.student_id = :studentId
ORDER BY r.observed_at_epoch_ms DESC, d.name;

selectAiAuditTotalsByUseCase:
SELECT use_case, COUNT(*) AS total_count, SUM(success) AS success_count, MAX(created_at_epoch_ms) AS last_created_at_epoch_ms
FROM ai_audit_events
GROUP BY use_case
ORDER BY total_count DESC, use_case;

selectRecentAiAuditAvailability:
SELECT availability, COUNT(*) AS total_count, MAX(created_at_epoch_ms) AS last_created_at_epoch_ms
FROM ai_audit_events
GROUP BY availability
ORDER BY last_created_at_epoch_ms DESC;

CREATE TABLE IF NOT EXISTS notebook_cell_audit_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    column_id TEXT NOT NULL,
    previous_numeric_value REAL,
    new_numeric_value REAL,
    previous_text_value TEXT,
    new_text_value TEXT,
    action TEXT NOT NULL,
    changed_at_epoch_ms INTEGER NOT NULL,
    author_user_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_notebook_cell_audit_lookup ON notebook_cell_audit_events(class_id, student_id, column_id, changed_at_epoch_ms DESC);

insertNotebookCellAudit:
INSERT INTO notebook_cell_audit_events(
    class_id, student_id, column_id,
    previous_numeric_value, new_numeric_value,
    previous_text_value, new_text_value,
    action, changed_at_epoch_ms, author_user_id, device_id, sync_version
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectNotebookCellAudit:
SELECT id, class_id, student_id, column_id,
       previous_numeric_value, new_numeric_value,
       previous_text_value, new_text_value,
       action, changed_at_epoch_ms, author_user_id, device_id, sync_version
FROM notebook_cell_audit_events
WHERE class_id = ? AND student_id = ? AND column_id = ?
ORDER BY changed_at_epoch_ms DESC;

selectStudentGradesHistory:
SELECT c.id AS column_id, c.title AS column_title, c.date_epoch_ms, e.value_ordinal AS score
FROM notebook_cell_entries e
JOIN notebook_columns c ON e.column_id = c.id
WHERE e.class_id = ? AND e.student_id = ? AND c.counts_toward_average = 1 AND e.value_ordinal IS NOT NULL
ORDER BY c.date_epoch_ms ASC;

countStudentAttendanceStats:
SELECT 
    COUNT(CASE WHEN LOWER(status) LIKE 'aus%' THEN 1 END) AS absent_count,
    COUNT(CASE WHEN LOWER(status) LIKE 'ret%' OR LOWER(status) LIKE 'tar%' THEN 1 END) AS late_count,
    COUNT(*) AS total_records
FROM attendance
WHERE class_id = ? AND student_id = ?;

selectStudentIncidentsHistory:
SELECT id, title, detail, severity, date_epoch_ms
FROM incidents
WHERE class_id = ? AND student_id = ?
ORDER BY date_epoch_ms DESC;

selectCompetencyCoverage:
SELECT c.id, c.code, c.name,
       (SELECT COUNT(*)
        FROM notebook_columns col
        WHERE col.class_id = ? AND col.competency_criteria_ids_csv LIKE '%' || c.code || '%') AS columns_count
FROM competency_criteria c
ORDER BY c.code;

-- ── sync_tombstones ──────────────────────────────────────────────────────

selectSyncTombstone:
SELECT deleted_at_epoch_ms, device_id
FROM sync_tombstones
WHERE entity = ? AND entity_id = ?;

upsertSyncTombstone:
INSERT INTO sync_tombstones(entity, entity_id, deleted_at_epoch_ms, device_id)
VALUES (?, ?, ?, ?)
ON CONFLICT(entity, entity_id) DO UPDATE SET
    deleted_at_epoch_ms = excluded.deleted_at_epoch_ms,
    device_id = excluded.device_id
WHERE excluded.deleted_at_epoch_ms >= sync_tombstones.deleted_at_epoch_ms;

deleteSyncTombstone:
DELETE FROM sync_tombstones WHERE entity = ? AND entity_id = ?;
