selectDashboardStats:
SELECT
  (SELECT COUNT(*) FROM students) AS total_students,
  (SELECT COUNT(*) FROM classes) AS total_classes,
  (SELECT COUNT(*) FROM evaluations) AS total_evaluations,
  (SELECT COUNT(*) FROM rubrics) AS total_rubrics,
  (SELECT COUNT(*) FROM sessions) AS total_sessions;

selectDashboardTodaySnapshot:
SELECT
  (SELECT COUNT(*) FROM classes) AS active_class_count,
  (SELECT COUNT(*) FROM students) AS active_student_count,
  (SELECT COUNT(*) FROM sessions WHERE date_epoch_ms >= :dayStartEpochMs AND date_epoch_ms < :dayEndEpochMs) AS today_session_count,
  (
    SELECT COUNT(*)
    FROM evaluations e
    WHERE NOT EXISTS (
      SELECT 1
      FROM grades g
      WHERE g.evaluation_id = e.id
        AND g.class_id = e.class_id
        AND g.value IS NOT NULL
    )
  ) AS pending_evaluation_count,
  (SELECT COUNT(*) FROM incidents WHERE date_epoch_ms >= :dayStartEpochMs AND date_epoch_ms < :dayEndEpochMs) AS incident_count;

