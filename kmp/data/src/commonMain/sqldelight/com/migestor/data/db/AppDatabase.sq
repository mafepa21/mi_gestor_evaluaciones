FROM classes
WHERE academic_year_id = ?
ORDER BY course, name;

selectCourseOverview:
SELECT
  c.id AS class_id,
  c.name,
  c.course,
  (
    SELECT COUNT(*)
    FROM students s
    WHERE EXISTS (
      SELECT 1 FROM student_enrollments se
      WHERE se.student_id = s.id
        AND se.class_id = c.id
        AND se.status = 'ACTIVE'
        AND se.academic_year_id = c.academic_year_id
    )
  ) AS student_count,
  (
    SELECT COUNT(*)
    FROM notebook_columns nc
    WHERE nc.class_id = c.id
      AND nc.visibility = 'VISIBLE'
      AND nc.is_hidden = 0
      AND nc.is_template = 0
  ) AS visible_column_count,
  (
    (
      SELECT COUNT(*)
      FROM students s
      WHERE EXISTS (
        SELECT 1 FROM student_enrollments se
        WHERE se.student_id = s.id
          AND se.class_id = c.id
          AND se.status = 'ACTIVE'
          AND se.academic_year_id = c.academic_year_id
      )
    ) * (
      SELECT COUNT(*)
      FROM notebook_columns nc
      WHERE nc.class_id = c.id
        AND nc.visibility = 'VISIBLE'
        AND nc.is_hidden = 0
        AND nc.is_template = 0
        AND nc.counts_toward_average = 1
    )
  ) - (
    SELECT COUNT(*)
    FROM grades g
    JOIN notebook_columns nc ON nc.id = g.column_id
    WHERE g.class_id = c.id
      AND g.value IS NOT NULL
      AND nc.class_id = c.id
      AND nc.visibility = 'VISIBLE'
      AND nc.is_hidden = 0
      AND nc.is_template = 0
      AND nc.counts_toward_average = 1
  ) AS pending_cell_count,
  (
    SELECT AVG(g.value)
    FROM grades g
    JOIN notebook_columns nc ON nc.id = g.column_id
    WHERE g.class_id = c.id
      AND g.value IS NOT NULL
      AND nc.class_id = c.id
      AND nc.visibility = 'VISIBLE'
      AND nc.is_hidden = 0
      AND nc.is_template = 0
      AND nc.counts_toward_average = 1
  ) AS average_score
FROM classes c
WHERE c.academic_year_id = (SELECT id FROM academic_years WHERE is_active = 1 LIMIT 1)
   OR (c.academic_year_id IS NULL AND NOT EXISTS (SELECT 1 FROM academic_years WHERE is_active = 1))
ORDER BY c.course, c.name;

selectClassAcademicYearId:
