selectStudentsByClass:
SELECT s.id, s.first_name, s.last_name, s.email, s.photo_path, s.is_injured, s.sex, s.sex_source, s.birth_date_iso, s.updated_at_epoch_ms, s.device_id, s.sync_version
FROM students s
WHERE EXISTS (
    SELECT 1 FROM student_enrollments se
    JOIN classes c ON c.id = se.class_id
    WHERE se.student_id = s.id
      AND se.class_id = ?
      AND se.status = 'ACTIVE'
      AND se.academic_year_id = c.academic_year_id
)
ORDER BY s.last_name, s.first_name, s.id;

selectStudentProfileSnapshot:
SELECT
  s.id AS student_id,
  s.first_name || ' ' || s.last_name AS full_name,
  s.email,
  s.photo_path,
  s.is_injured,
  (
    SELECT COUNT(*)
    FROM student_enrollments se
    WHERE se.student_id = s.id
      AND se.status = 'ACTIVE'
  ) AS class_count,
  (
    SELECT COUNT(DISTINCT e.id)
    FROM student_enrollments se
    JOIN evaluations e ON e.class_id = se.class_id
    WHERE se.student_id = s.id
      AND se.status = 'ACTIVE'
  ) AS active_evaluation_count,
  (
    SELECT MAX(activity_epoch_ms)
    FROM (
      SELECT g.updated_at_epoch_ms AS activity_epoch_ms
      FROM grades g
      WHERE g.student_id = s.id
      UNION ALL
      SELECT n.updated_at_epoch_ms AS activity_epoch_ms
      FROM notebook_cell_entries n
      WHERE n.student_id = s.id
      UNION ALL
      SELECT a.updated_at_epoch_ms AS activity_epoch_ms
      FROM attendance a
      WHERE a.student_id = s.id
      UNION ALL
      SELECT p.updated_at_epoch_ms AS activity_epoch_ms
      FROM physical_test_results p
      WHERE p.student_id = s.id
    )
  ) AS latest_activity_epoch_ms,
  (
    SELECT AVG(g.value)
    FROM grades g
    WHERE g.student_id = s.id
      AND g.value IS NOT NULL
  ) AS average_score
FROM students s
WHERE s.id = :studentId
LIMIT 1;

selectEvaluationsByClass:
SELECT id, class_id, code, name, type, weight, formula, rubric_id, description, author_user_id, created_at_epoch_ms, updated_at_epoch_ms, associated_group_id, device_id, sync_version
FROM evaluations
WHERE class_id = ?
ORDER BY id;

selectPendingEvaluationsSummary:
SELECT
  c.id AS class_id,
  (SELECT COUNT(*) FROM evaluations e WHERE e.class_id = c.id) AS evaluation_count,
  (
    (SELECT COUNT(*) FROM evaluations e WHERE e.class_id = c.id) *
    (
      SELECT COUNT(*)
      FROM students s
      WHERE EXISTS (
        SELECT 1 FROM student_enrollments se
        WHERE se.student_id = s.id
          AND se.class_id = c.id
          AND se.status = 'ACTIVE'
          AND se.academic_year_id = c.academic_year_id
      )
    )
  ) - (
    SELECT COUNT(*)
    FROM grades g
    JOIN evaluations e ON e.id = g.evaluation_id
    WHERE e.class_id = c.id
      AND g.class_id = c.id
      AND g.value IS NOT NULL
  ) AS pending_cell_count,
  (
    SELECT COUNT(*)
    FROM grades g
    JOIN evaluations e ON e.id = g.evaluation_id
    WHERE e.class_id = c.id
      AND g.class_id = c.id
      AND g.value IS NOT NULL
  ) AS completed_cell_count,
  CASE
    WHEN (
      (SELECT COUNT(*) FROM evaluations e WHERE e.class_id = c.id) *
      (
        SELECT COUNT(*)
        FROM students s
        WHERE EXISTS (
          SELECT 1 FROM student_enrollments se
          WHERE se.student_id = s.id
            AND se.class_id = c.id
            AND se.status = 'ACTIVE'
            AND se.academic_year_id = c.academic_year_id
        )
      )
    ) = 0 THEN 100
    ELSE CAST(ROUND(100.0 * (
      SELECT COUNT(*)
      FROM grades g
      JOIN evaluations e ON e.id = g.evaluation_id
      WHERE e.class_id = c.id
        AND g.class_id = c.id
        AND g.value IS NOT NULL
    ) / (
      (SELECT COUNT(*) FROM evaluations e WHERE e.class_id = c.id) *
      (
        SELECT COUNT(*)
        FROM students s
        WHERE EXISTS (
          SELECT 1 FROM student_enrollments se
          WHERE se.student_id = s.id
            AND se.class_id = c.id
            AND se.status = 'ACTIVE'
            AND se.academic_year_id = c.academic_year_id
        )
      )
    )) AS INTEGER)
  END AS completion_pct
FROM classes c
WHERE c.id = :classId;

