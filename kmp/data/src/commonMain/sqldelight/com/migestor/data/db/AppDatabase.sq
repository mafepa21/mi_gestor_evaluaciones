selectColumnsByClass:
SELECT id, class_id, title, type, category_kind, instrument_kind, input_kind, evaluation_id, formula, weight, date_epoch_ms, unit_name, competency_criteria_ids_csv, scale_kind, tab_ids_csv, shared_across_tabs, color_hex, icon_name, sort_order, width_dp, category_id, visibility, is_locked, counts_toward_average, is_pinned, is_hidden, is_template, empty_cell_policy, updated_at_epoch_ms, device_id, sync_version
FROM notebook_columns
WHERE class_id = ?
ORDER BY sort_order, id;

selectNotebookVisibleColumns:
SELECT id, title, type, evaluation_id, category_id, sort_order, width_dp, is_pinned
FROM notebook_columns
WHERE class_id = :classId
  AND visibility = 'VISIBLE'
  AND is_hidden = 0
  AND is_template = 0
  AND (:tabId IS NULL OR shared_across_tabs = 1 OR (',' || tab_ids_csv || ',') LIKE '%,' || :tabId || ',%')
ORDER BY is_pinned DESC, sort_order, id;

selectNotebookRowsPage:
SELECT
  s.id AS student_id,
  s.first_name,
  s.last_name,
  s.is_injured,
  (
    SELECT COUNT(*)
    FROM grades g
    WHERE g.class_id = c.id
      AND g.student_id = s.id
      AND g.value IS NOT NULL
  ) + (
    SELECT COUNT(*)
    FROM notebook_cell_entries n
    WHERE n.class_id = c.id
      AND n.student_id = s.id
      AND (
        n.value_text IS NOT NULL OR
        n.value_bool IS NOT NULL OR
        n.value_icon IS NOT NULL OR
        n.value_ordinal IS NOT NULL OR
        n.display_value IS NOT NULL
      )
  ) AS filled_cell_count,
  (
    SELECT AVG(g.value)
    FROM grades g
    JOIN notebook_columns nc ON nc.id = g.column_id
    WHERE g.class_id = c.id
      AND g.student_id = s.id
      AND g.value IS NOT NULL
      AND nc.class_id = c.id
      AND nc.visibility = 'VISIBLE'
      AND nc.is_hidden = 0
      AND nc.is_template = 0
      AND nc.counts_toward_average = 1
  ) AS average_score
FROM students s
JOIN classes c ON c.id = :classId
WHERE EXISTS (
    SELECT 1 FROM student_enrollments se
    WHERE se.student_id = s.id
      AND se.class_id = c.id
      AND se.status = 'ACTIVE'
      AND se.academic_year_id = c.academic_year_id
)
ORDER BY s.last_name, s.first_name, s.id
LIMIT :limit OFFSET :offset;

selectNotebookSummary:
SELECT
  c.id AS class_id,
  (
    SELECT COUNT(*)
    FROM students s
    WHERE EXISTS (
      SELECT 1 FROM student_enrollments se
      WHERE se.student_id = s.id
        AND se.class_id = c.id
        AND se.status = 'ACTIVE'
        AND se.academic_year_id = c.academic_year_id
    )
  ) AS student_count,
  (
    SELECT COUNT(*)
    FROM notebook_columns nc
    WHERE nc.class_id = c.id
      AND nc.visibility = 'VISIBLE'
      AND nc.is_hidden = 0
      AND nc.is_template = 0
  ) AS visible_column_count,
  (
    (
      SELECT COUNT(*)
      FROM students s
      WHERE EXISTS (
        SELECT 1 FROM student_enrollments se
        WHERE se.student_id = s.id
          AND se.class_id = c.id
          AND se.status = 'ACTIVE'
          AND se.academic_year_id = c.academic_year_id
      )
    ) * (
      SELECT COUNT(*)
      FROM notebook_columns nc
      WHERE nc.class_id = c.id
        AND nc.visibility = 'VISIBLE'
        AND nc.is_hidden = 0
        AND nc.is_template = 0
        AND nc.counts_toward_average = 1
    )
  ) - (
    SELECT COUNT(*)
    FROM grades g
    JOIN notebook_columns nc ON nc.id = g.column_id
    WHERE g.class_id = c.id
      AND g.value IS NOT NULL
      AND nc.class_id = c.id
      AND nc.visibility = 'VISIBLE'
      AND nc.is_hidden = 0
      AND nc.is_template = 0
      AND nc.counts_toward_average = 1
  ) AS pending_cell_count,
  (
    SELECT AVG(g.value)
    FROM grades g
    JOIN notebook_columns nc ON nc.id = g.column_id
    WHERE g.class_id = c.id
      AND g.value IS NOT NULL
      AND nc.class_id = c.id
      AND nc.visibility = 'VISIBLE'
      AND nc.is_hidden = 0
      AND nc.is_template = 0
      AND nc.counts_toward_average = 1
  ) AS average_score
FROM classes c
WHERE c.id = :classId;

