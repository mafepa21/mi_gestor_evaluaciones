CREATE TABLE IF NOT EXISTS students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    email TEXT,
    photo_path TEXT,
    is_injured INTEGER NOT NULL DEFAULT 0,
    sex TEXT NOT NULL DEFAULT 'UNSPECIFIED',
    sex_source TEXT NOT NULL DEFAULT 'UNKNOWN',
    birth_date_iso TEXT,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS classes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    course INTEGER NOT NULL,
    description TEXT,
    center_id INTEGER,
    academic_year_id INTEGER,
    stage_cycle_id INTEGER,
    subject_id INTEGER,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (center_id) REFERENCES centers(id) ON DELETE SET NULL,
    FOREIGN KEY (academic_year_id) REFERENCES academic_years(id) ON DELETE SET NULL,
    FOREIGN KEY (stage_cycle_id) REFERENCES stage_cycles(id) ON DELETE SET NULL,
    FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_classes_subject ON classes(subject_id);
CREATE INDEX IF NOT EXISTS idx_classes_academic_year ON classes(academic_year_id);

CREATE TABLE IF NOT EXISTS class_students (
    class_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    PRIMARY KEY (class_id, student_id),
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS periods (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    start_epoch_ms INTEGER NOT NULL,
    end_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS units (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    period_id INTEGER NOT NULL,
    title TEXT NOT NULL,
    objectives TEXT NOT NULL,
    competences TEXT NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (period_id) REFERENCES periods(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS sessions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    unit_id INTEGER NOT NULL,
    date_epoch_ms INTEGER NOT NULL,
    description TEXT NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (unit_id) REFERENCES units(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS rubrics (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    class_id INTEGER,
    teaching_unit_id INTEGER,
    competency_id INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS rubric_criteria (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    rubric_id INTEGER NOT NULL,
    description TEXT NOT NULL,
    weight REAL NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    competency_id INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (rubric_id) REFERENCES rubrics(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_rubric_criteria_rubric_sort ON rubric_criteria(rubric_id, sort_order, id);

CREATE TABLE IF NOT EXISTS rubric_levels (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    criterion_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    points INTEGER NOT NULL,
    description TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (criterion_id) REFERENCES rubric_criteria(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_rubric_levels_criterion_sort ON rubric_levels(criterion_id, sort_order, id);

CREATE TABLE IF NOT EXISTS evaluations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id INTEGER NOT NULL,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    weight REAL NOT NULL,
    formula TEXT,
    rubric_id INTEGER,
    description TEXT,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (rubric_id) REFERENCES rubrics(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_evaluations_class_id ON evaluations(class_id, id);

CREATE TABLE IF NOT EXISTS grades (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    column_id TEXT NOT NULL,
    evaluation_id INTEGER,
    value REAL,
    evidence TEXT,
    evidence_path TEXT,
    rubric_selections TEXT,
    created_at_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(class_id, student_id, column_id),
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (evaluation_id) REFERENCES evaluations(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_grades_class_student ON grades(class_id, student_id);
CREATE INDEX IF NOT EXISTS idx_grades_class_column ON grades(class_id, column_id);
CREATE INDEX IF NOT EXISTS idx_grades_evaluation ON grades(evaluation_id);

CREATE TABLE IF NOT EXISTS rubric_assessments (
    student_id INTEGER NOT NULL,
    evaluation_id INTEGER NOT NULL,
    criterion_id INTEGER NOT NULL,
    level_id INTEGER NOT NULL,
    created_at_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (student_id, evaluation_id, criterion_id),
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (evaluation_id) REFERENCES evaluations(id) ON DELETE CASCADE,
    FOREIGN KEY (criterion_id) REFERENCES rubric_criteria(id) ON DELETE CASCADE,
    FOREIGN KEY (level_id) REFERENCES rubric_levels(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS attendance (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id INTEGER NOT NULL,
    class_id INTEGER NOT NULL,
    date_epoch_ms INTEGER NOT NULL,
    status TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    has_incident INTEGER NOT NULL DEFAULT 0,
    follow_up_required INTEGER NOT NULL DEFAULT 0,
    session_id INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_attendance_class_date_student ON attendance(class_id, date_epoch_ms DESC, student_id);
CREATE INDEX IF NOT EXISTS idx_attendance_class_student_date ON attendance(class_id, student_id, date_epoch_ms DESC);

CREATE TABLE IF NOT EXISTS backup_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    path TEXT NOT NULL,
    created_at_epoch_ms INTEGER NOT NULL,
    platform TEXT NOT NULL,
    size_bytes INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS centers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    code TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS academic_years (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    center_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    start_epoch_ms INTEGER NOT NULL,
    end_epoch_ms INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    is_active INTEGER NOT NULL DEFAULT 0,
    archived_at_epoch_ms INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (center_id) REFERENCES centers(id) ON DELETE CASCADE
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_academic_years_active
ON academic_years(is_active)
WHERE is_active = 1;

CREATE TABLE IF NOT EXISTS student_enrollments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id INTEGER NOT NULL,
    class_id INTEGER NOT NULL,
    academic_year_id INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    promotion_status TEXT NOT NULL DEFAULT 'PENDING',
    previous_enrollment_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(student_id, class_id, academic_year_id),
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (academic_year_id) REFERENCES academic_years(id) ON DELETE CASCADE,
    FOREIGN KEY (previous_enrollment_id) REFERENCES student_enrollments(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_student_enrollments_year_class
ON student_enrollments(academic_year_id, class_id, status);
CREATE INDEX IF NOT EXISTS idx_student_enrollments_student_year
ON student_enrollments(student_id, academic_year_id);

-- Tombstones genéricos para la sincronización LAN: registran cuándo se borró
-- por última vez una entidad (entity + entity_id, el mismo par que viaja en
-- SyncChange) para que un upsert de otro dispositivo, sincronizado más tarde
-- pero fechado ANTES del borrado, no la resucite. Independiente del propio
-- borrado físico de cada tabla: no cambia el comportamiento normal de la app.
CREATE TABLE IF NOT EXISTS sync_tombstones (
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    deleted_at_epoch_ms INTEGER NOT NULL,
    device_id TEXT,
    PRIMARY KEY (entity, entity_id)
);

CREATE TABLE IF NOT EXISTS stage_cycles (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    center_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    level TEXT,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (center_id) REFERENCES centers(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS subjects (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    stage_cycle_id INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (stage_cycle_id) REFERENCES stage_cycles(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS app_users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    external_id TEXT,
    display_name TEXT NOT NULL,
    email TEXT,
    role TEXT NOT NULL,
    center_id INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (center_id) REFERENCES centers(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS teacher_schedules (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    owner_user_id INTEGER NOT NULL,
    academic_year_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    start_date TEXT NOT NULL,
    end_date TEXT NOT NULL,
    active_weekdays TEXT NOT NULL DEFAULT '1,2,3,4,5',
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (owner_user_id) REFERENCES app_users(id) ON DELETE CASCADE,
    FOREIGN KEY (academic_year_id) REFERENCES academic_years(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS teacher_schedule_slots (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    teacher_schedule_id INTEGER NOT NULL,
    school_class_id INTEGER NOT NULL,
    subject_label TEXT NOT NULL DEFAULT '',
    unit_label TEXT,
    day_of_week INTEGER NOT NULL,
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    weekly_template_id INTEGER,
    FOREIGN KEY (teacher_schedule_id) REFERENCES teacher_schedules(id) ON DELETE CASCADE,
    FOREIGN KEY (school_class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (weekly_template_id) REFERENCES weekly_slot_template(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_teacher_schedule_slots_schedule_day_start ON teacher_schedule_slots(teacher_schedule_id, day_of_week, start_time, id);
CREATE INDEX IF NOT EXISTS idx_teacher_schedule_slots_class_day_start ON teacher_schedule_slots(school_class_id, day_of_week, start_time);

CREATE TABLE IF NOT EXISTS planner_evaluation_periods (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    teacher_schedule_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    start_date TEXT NOT NULL,
    end_date TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (teacher_schedule_id) REFERENCES teacher_schedules(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS competency_criteria (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    stage_cycle_id INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (stage_cycle_id) REFERENCES stage_cycles(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS learning_activities (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id INTEGER NOT NULL,
    title TEXT NOT NULL,
    description TEXT,
    due_epoch_ms INTEGER,
    rubric_id INTEGER,
    competency_ids_csv TEXT,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (rubric_id) REFERENCES rubrics(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS evaluation_competency_links (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    evaluation_id INTEGER NOT NULL,
    competency_id INTEGER NOT NULL,
    weight REAL NOT NULL DEFAULT 1.0,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (evaluation_id) REFERENCES evaluations(id) ON DELETE CASCADE,
    FOREIGN KEY (competency_id) REFERENCES competency_criteria(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_evaluation_competency_links_evaluation ON evaluation_competency_links(evaluation_id, id);

CREATE TABLE IF NOT EXISTS incidents (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id INTEGER NOT NULL,
    student_id INTEGER,
    title TEXT NOT NULL,
    detail TEXT,
    severity TEXT NOT NULL DEFAULT 'low',
    date_epoch_ms INTEGER NOT NULL,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_incidents_class_date ON incidents(class_id, date_epoch_ms DESC, id DESC);
CREATE INDEX IF NOT EXISTS idx_incidents_class_student_date ON incidents(class_id, student_id, date_epoch_ms DESC);

CREATE TABLE IF NOT EXISTS calendar_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    class_id INTEGER,
    title TEXT NOT NULL,
    description TEXT,
    start_epoch_ms INTEGER NOT NULL,
    end_epoch_ms INTEGER NOT NULL,
    external_provider TEXT,
    external_id TEXT,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS configuration_templates (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    center_id INTEGER,
    owner_user_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (center_id) REFERENCES centers(id) ON DELETE SET NULL,
    FOREIGN KEY (owner_user_id) REFERENCES app_users(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS configuration_template_versions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    template_id INTEGER NOT NULL,
    version_number INTEGER NOT NULL,
    payload_json TEXT NOT NULL,
    based_on_version_id INTEGER,
    source_academic_year_id INTEGER,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (template_id) REFERENCES configuration_templates(id) ON DELETE CASCADE,
    FOREIGN KEY (based_on_version_id) REFERENCES configuration_template_versions(id) ON DELETE SET NULL,
    FOREIGN KEY (source_academic_year_id) REFERENCES academic_years(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS learning_situations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    stage_label TEXT NOT NULL DEFAULT '',
    course_label TEXT NOT NULL DEFAULT '',
    subject_label TEXT NOT NULL DEFAULT '',
    term_label TEXT NOT NULL DEFAULT '',
    center_label TEXT NOT NULL DEFAULT '',
    session_count INTEGER NOT NULL DEFAULT 0,
    challenge TEXT NOT NULL DEFAULT '',
    final_product TEXT NOT NULL DEFAULT '',
    payload_json TEXT NOT NULL DEFAULT '{}',
    status TEXT NOT NULL DEFAULT 'DRAFT',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS learning_situation_versions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    learning_situation_id INTEGER NOT NULL,
    version_number INTEGER NOT NULL,
    original_file_name TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    local_path TEXT,
    size_bytes INTEGER NOT NULL DEFAULT 0,
    payload_json TEXT NOT NULL DEFAULT '{}',
    warnings_json TEXT NOT NULL DEFAULT '[]',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(learning_situation_id, version_number),
    FOREIGN KEY (learning_situation_id) REFERENCES learning_situations(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_learning_situation_versions_lookup ON learning_situation_versions(learning_situation_id, version_number DESC);

CREATE TABLE IF NOT EXISTS learning_situation_classes (
    learning_situation_id INTEGER NOT NULL,
    class_id INTEGER NOT NULL,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (learning_situation_id, class_id),
    FOREIGN KEY (learning_situation_id) REFERENCES learning_situations(id) ON DELETE CASCADE,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS learning_situation_links (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    learning_situation_id INTEGER NOT NULL,
    resource_kind TEXT NOT NULL,
    resource_id TEXT NOT NULL,
    class_id INTEGER,
    label TEXT NOT NULL DEFAULT '',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(learning_situation_id, resource_kind, resource_id, class_id),
    FOREIGN KEY (learning_situation_id) REFERENCES learning_situations(id) ON DELETE CASCADE,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_learning_situation_links_lookup ON learning_situation_links(learning_situation_id, resource_kind, label);

CREATE TABLE IF NOT EXISTS learning_situation_sequence_versions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    learning_situation_id INTEGER NOT NULL,
    version_number INTEGER NOT NULL,
    original_file_name TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    local_path TEXT,
    size_bytes INTEGER NOT NULL DEFAULT 0,
    payload_json TEXT NOT NULL DEFAULT '{}',
    warnings_json TEXT NOT NULL DEFAULT '[]',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(learning_situation_id, version_number),
    FOREIGN KEY (learning_situation_id) REFERENCES learning_situations(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_learning_situation_sequence_versions_lookup ON learning_situation_sequence_versions(learning_situation_id, version_number DESC);

CREATE TABLE IF NOT EXISTS learning_situation_session_plans (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    learning_situation_id INTEGER NOT NULL,
    sequence_version_id INTEGER NOT NULL,
    session_number INTEGER NOT NULL,
    source_label TEXT NOT NULL DEFAULT '',
    title TEXT NOT NULL,
    session_type TEXT NOT NULL DEFAULT '',
    effective_minutes INTEGER NOT NULL DEFAULT 0,
    objective TEXT NOT NULL DEFAULT '',
    criteria_json TEXT NOT NULL DEFAULT '[]',
    material TEXT NOT NULL DEFAULT '',
    development_json TEXT NOT NULL DEFAULT '[]',
    adaptations_json TEXT NOT NULL DEFAULT '[]',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    UNIQUE(sequence_version_id, session_number),
    FOREIGN KEY (learning_situation_id) REFERENCES learning_situations(id) ON DELETE CASCADE,
    FOREIGN KEY (sequence_version_id) REFERENCES learning_situation_sequence_versions(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_learning_situation_session_plans_sequence ON learning_situation_session_plans(sequence_version_id, session_number);

CREATE TABLE IF NOT EXISTS notebook_cell_entries (
    class_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    column_id TEXT NOT NULL,
    value_text TEXT,
    value_bool INTEGER,
    value_icon TEXT,
    value_ordinal TEXT,
    display_value TEXT,
    observed_at_epoch_ms INTEGER,
    competency_criteria_ids_csv TEXT NOT NULL DEFAULT '',
    effective_weight REAL,
    counts_toward_average INTEGER,
    note TEXT,
    color_hex TEXT,
    attachment_uris_csv TEXT,
    author_user_id INTEGER,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    associated_group_id INTEGER,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (class_id, student_id, column_id),
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_notebook_cell_entries_column ON notebook_cell_entries(column_id);

CREATE TABLE IF NOT EXISTS notebook_instrument_templates (
    id TEXT NOT NULL PRIMARY KEY,
    class_id INTEGER NOT NULL,
    column_id TEXT NOT NULL UNIQUE,
    evaluation_id INTEGER,
    title TEXT NOT NULL,
    kind TEXT NOT NULL,
    input_kind TEXT NOT NULL,
    source TEXT,
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (column_id) REFERENCES notebook_columns(id) ON DELETE CASCADE,
    FOREIGN KEY (evaluation_id) REFERENCES evaluations(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS idx_notebook_instrument_templates_class ON notebook_instrument_templates(class_id);
CREATE INDEX IF NOT EXISTS idx_notebook_instrument_templates_column ON notebook_instrument_templates(column_id);

CREATE TABLE IF NOT EXISTS notebook_instrument_items (
    id TEXT NOT NULL PRIMARY KEY,
    template_id TEXT NOT NULL,
    item_key TEXT NOT NULL,
    title TEXT NOT NULL,
    item_type TEXT NOT NULL,
    options_csv TEXT NOT NULL DEFAULT '',
    required INTEGER NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 0,
    help_text TEXT,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (template_id) REFERENCES notebook_instrument_templates(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_notebook_instrument_items_template ON notebook_instrument_items(template_id, sort_order, id);

CREATE TABLE IF NOT EXISTS notebook_instrument_responses (
    class_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    column_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    value_text TEXT,
    value_bool INTEGER,
    value_number REAL,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (class_id, student_id, column_id, item_id),
    FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE,
    FOREIGN KEY (column_id) REFERENCES notebook_columns(id) ON DELETE CASCADE,
    FOREIGN KEY (item_id) REFERENCES notebook_instrument_items(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_notebook_instrument_responses_cell ON notebook_instrument_responses(class_id, student_id, column_id);
CREATE INDEX IF NOT EXISTS idx_notebook_instrument_responses_item ON notebook_instrument_responses(item_id);

