FROM rubric_assessments
WHERE student_id = ? AND evaluation_id = ? AND criterion_id = ?
LIMIT 1;

selectWeightedRubricScore:
SELECT ROUND(
  SUM(
    (
      (CASE WHEN rl.points > 0 THEN rl.points ELSE rl.sort_order END * 1.0) /
      (SELECT CASE WHEN MAX(CASE WHEN rl2.points > 0 THEN rl2.points ELSE rl2.sort_order END) > 1 THEN CAST(MAX(CASE WHEN rl2.points > 0 THEN rl2.points ELSE rl2.sort_order END) AS REAL) ELSE 1.0 END FROM rubric_levels rl2 WHERE rl2.criterion_id = rc.id)
    ) * (CASE WHEN rc.weight > 0.0 THEN rc.weight ELSE 1.0 END)
  ) / SUM(CASE WHEN rc.weight > 0.0 THEN rc.weight ELSE 1.0 END) * 10.0
, 2) AS score
FROM rubric_assessments ra
INNER JOIN rubric_criteria rc ON rc.id = ra.criterion_id
INNER JOIN rubric_levels rl ON rl.id = ra.level_id
WHERE ra.student_id = ? AND ra.evaluation_id = ?;

selectStudentEvaluation:
SELECT ra.criterion_id, ra.level_id 
FROM rubric_assessments ra
JOIN rubric_criteria rc ON ra.criterion_id = rc.id
WHERE ra.student_id = ? AND rc.rubric_id = ? AND ra.evaluation_id = ?;

