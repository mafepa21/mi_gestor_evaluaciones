-- Marcas «Fuerte» / «Necesita apoyo» para organizar grupos (migración 52).
-- El DDL debe coincidir letra por letra con 52.sqm: el test de ruta canónica
-- compara instalación nueva y migrada (defaults e índices incluidos).
-- En producción PRAGMA foreign_keys = 0: el borrado de un alumno o de un grupo limpia
-- sus marcas con deleteGroupMarksByStudent / deleteGroupMarksByClass.
CREATE TABLE IF NOT EXISTS student_group_marks (
    student_id INTEGER NOT NULL,
    class_id INTEGER NOT NULL,
    mark TEXT NOT NULL DEFAULT 'NONE',
    created_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    device_id TEXT,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (student_id, class_id)
);
CREATE INDEX IF NOT EXISTS idx_student_group_marks_class ON student_group_marks(class_id);

selectAllGroupMarks:
SELECT student_id, class_id, mark, created_at_epoch_ms, updated_at_epoch_ms, device_id, sync_version
FROM student_group_marks;

selectGroupMarksByClass:
SELECT student_id, class_id, mark, created_at_epoch_ms, updated_at_epoch_ms, device_id, sync_version
FROM student_group_marks
WHERE class_id = ?;

selectGroupMark:
SELECT student_id, class_id, mark, created_at_epoch_ms, updated_at_epoch_ms, device_id, sync_version
FROM student_group_marks
WHERE student_id = ? AND class_id = ?;

-- Alta o cambio en el sitio: conserva created_at_epoch_ms y sube sync_version.
upsertGroupMark:
INSERT INTO student_group_marks(student_id, class_id, mark, created_at_epoch_ms, updated_at_epoch_ms, device_id, sync_version)
VALUES (?, ?, ?, ?, ?, ?, 1)
ON CONFLICT(student_id, class_id) DO UPDATE SET
    mark = excluded.mark,
    updated_at_epoch_ms = excluded.updated_at_epoch_ms,
    device_id = excluded.device_id,
    sync_version = student_group_marks.sync_version + 1;

deleteGroupMark:
DELETE FROM student_group_marks WHERE student_id = ? AND class_id = ?;

deleteGroupMarksByStudent:
DELETE FROM student_group_marks WHERE student_id = ?;

deleteGroupMarksByClass:
DELETE FROM student_group_marks WHERE class_id = ?;
