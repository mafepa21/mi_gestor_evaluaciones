<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla: package_mac_release.sh sustituye @VERSION@ y @PKG@. -->
<installer-gui-script minSpecVersion="2">
    <title>Cuaderno Vivo</title>
    <background file="background.png" mime-type="image/png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background.png" mime-type="image/png" alignment="bottomleft" scaling="none"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64" rootVolumeOnly="true"/>
    <!-- Sin <domains>: con rootVolumeOnly, Installer instala en el disco de
         arranque y se salta el paso «Seleccionar destino», que solo tendría
         una opción. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="26.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.migestor.mac"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.migestor.mac" visible="false" title="Cuaderno Vivo">
        <pkg-ref id="com.migestor.mac"/>
    </choice>
    <pkg-ref id="com.migestor.mac" version="@VERSION@" onConclusion="none">@PKG@</pkg-ref>
</installer-gui-script>
